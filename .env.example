# Application
NODE_ENV=development
APP_NAME=TradeMaster
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trademaster
POSTGRES_USER=trademaster
POSTGRES_PASSWORD=changeme

MONGODB_URI=mongodb://localhost:27017/trademaster
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# AI/ML Services
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview
TENSORFLOW_SERVING_URL=http://localhost:8501

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_BLUEPRINTS=trademaster-blueprints
S3_BUCKET_PHOTOS=trademaster-photos

# Payment
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
SENDGRID_API_KEY=
FROM_EMAIL=noreply@trademaster.io

# Maps & Geolocation
GOOGLE_MAPS_API_KEY=

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
FEATURE_AR_TRAINING=true
FEATURE_MARKETPLACE=true
FEATURE_COST_PREDICTION=true
