# Environment
ENV=development

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=9001
HOST=0.0.0.0

# Database - PostgreSQL (for ML model metadata)
DATABASE_URL=postgresql://trademaster:password@localhost:5432/trademaster

# Database - MongoDB (for training data)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trademaster_ml

# Redis (for caching predictions)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600 # 1 hour

# Model Storage
MODEL_STORAGE_PATH=./models
S3_BUCKET=trademaster-ml-models
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Computer Vision Service
CV_MODEL_NAME=yolov8
CV_MODEL_VERSION=latest
CV_CONFIDENCE_THRESHOLD=0.7
CV_MAX_FILE_SIZE=10485760 # 10MB in bytes

# Cost Prediction Service
COST_MODEL_NAME=lstm_cost_predictor
COST_MODEL_VERSION=v1.0
COST_RETRAIN_INTERVAL=86400 # 24 hours in seconds

# Training Coach Service
COACH_MODEL_NAME=gpt-4
COACH_TEMPERATURE=0.7
OPENAI_API_KEY=your-openai-api-key

# Inventory Optimization Service
INVENTORY_ALGORITHM=reinforcement_learning
INVENTORY_HORIZON_DAYS=90

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
USE_GPU=true
GPU_MEMORY_FRACTION=0.8

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics
ENABLE_PROMETHEUS=true
METRICS_PORT=9100

# External APIs
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Feature Flags
ENABLE_BATCH_PROCESSING=true
ENABLE_MODEL_VERSIONING=true
ENABLE_AUTO_RETRAIN=false
